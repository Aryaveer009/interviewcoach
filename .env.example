# Copy to .env and fill in. Leave everything unset to run fully offline in mock mode.

# mock   = deterministic offline heuristic (no key, no network)  [default when no key is set]
# openai = any OpenAI-compatible endpoint (OpenAI, Groq, Together, Ollama, vLLM, ...)
LLM_PROVIDER=mock

# Needed for LLM_PROVIDER=openai (a local server such as Ollama does not need a real key)
LLM_API_KEY=
# Leave empty for api.openai.com; e.g. http://localhost:11434/v1 for Ollama
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Where the local SQLite database lives (default: ~/.interviewcoach/interviewcoach.db)
# INTERVIEWCOACH_DB=./data/interviewcoach.db

# Voice mode (optional): off | api (Whisper via the endpoint above) | local (faster-whisper)
STT_BACKEND=off
STT_API_MODEL=whisper-1
WHISPER_MODEL=base.en
